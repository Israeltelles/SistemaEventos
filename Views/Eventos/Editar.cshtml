@model SistemaEventos.Models.EventoModel

@{
    ViewData["Title"] = "Editar Evento";
}

<link rel="stylesheet" href="~/css/Eventos.css" />

<section class="evento-criar-wrapper">

    <div class="evento-criar-header">
        <h1>Editar Evento</h1>
        <p>Atualize os dados do evento cadastrado</p>
    </div>

    <div class="evento-criar-container">

        <div class="evento-criar-form-section">

            <h2>Dados do Evento</h2>

            <form asp-controller="Eventos" asp-action="Editar" asp-route-id="@Model.Id" method="post">

                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />

                <div class="evento-criar-form-group">
                    <label asp-for="Nome">Nome do Evento</label>
                    <input asp-for="Nome"
                           type="text"
                           placeholder="Digite o nome do evento"
                           required />
                    <span asp-validation-for="Nome" class="evento-erro"></span>
                </div>

                <div class="evento-criar-row">
                    <div class="evento-criar-form-group">
                        <label asp-for="Data">Data do Evento</label>
                        <input asp-for="Data"
                               type="date"
                               required />
                        <span asp-validation-for="Data" class="evento-erro"></span>
                    </div>

                    <div class="evento-criar-form-group">
                        <label asp-for="Local">Local do Evento</label>
                        <input asp-for="Local"
                               type="text"
                               placeholder="Local onde será realizado"
                               required />
                        <span asp-validation-for="Local" class="evento-erro"></span>
                    </div>
                </div>

                <div class="evento-criar-row">
                    <div class="evento-criar-form-group">
                        <label asp-for="HoraInicio">Hora de Início</label>
                        <input asp-for="HoraInicio"
                               type="time"
                               required />
                        <span asp-validation-for="HoraInicio" class="evento-erro"></span>
                    </div>

                    <div class="evento-criar-form-group">
                        <label asp-for="HoraFim">Hora de Término</label>
                        <input asp-for="HoraFim"
                               type="time"
                               required />
                        <span asp-validation-for="HoraFim" class="evento-erro"></span>
                    </div>
                </div>

                <div class="evento-criar-form-group">
                    <label asp-for="Descricao">Descrição do Evento</label>
                    <textarea asp-for="Descricao"
                              placeholder="Descreva o evento"
                              required></textarea>
                    <span asp-validation-for="Descricao" class="evento-erro"></span>
                </div>

                <div class="evento-criar-actions">
                    <a asp-controller="Eventos" asp-action="Gerenciar" class="btn-evento-voltar">
                        Voltar
                    </a>

                    <button type="submit" class="btn-evento-salvar">
                        Salvar Alterações
                    </button>
                </div>

            </form>

        </div>

        <div class="evento-criar-info-section">

            <h2>Informações</h2>

            <div class="evento-criar-info-card">
                <h3>📅 Edição de eventos</h3>
                <p>
                    Altere apenas os dados necessários para manter a programação atualizada.
                </p>
            </div>

            <div class="evento-criar-info-card">
                <h3>✅ Após salvar</h3>
                <p>
                    O evento será atualizado na listagem de eventos disponíveis.
                </p>
            </div>

        </div>

    </div>

</section>
