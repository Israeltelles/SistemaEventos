@model SistemaEventos.Models.UsuarioModel

@{
    Layout = null;
    ViewData["Title"] = "Cadastro de Aluno";
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b0914" />
    <title>@ViewData["Title"] - SistemaEventos</title>
    <link rel="stylesheet" href="~/css/LoginCadastro.css" />
    <link rel="stylesheet" href="~/css/Theme.css" />
</head>
<body class="auth-register-page auth-register-page--standalone">
    <main class="auth-register-shell">
        <a asp-controller="Usuario" asp-action="Login" class="auth-back-link"><span aria-hidden="true">←</span> Voltar ao login</a>
        <div class="auth-register-intro">
            <a asp-controller="Home" asp-action="Index" class="auth-brand">
                <span class="auth-brand-mark">SE</span>
                <span><strong>EVENTOS</strong><small>PORTAL ACADÊMICO</small></span>
            </a>
            <span class="showcase-eyebrow"><i></i> SUA JORNADA COMEÇA AQUI</span>
            <h1>Faça parte de novas experiências.</h1>
            <p>Crie sua conta para descobrir eventos, acompanhar inscrições e reunir suas conquistas acadêmicas.</p>
            <div class="register-progress-art" aria-hidden="true"><span>01</span><i></i><span>02</span><i></i><span>03</span><small>DESCOBRIR · PARTICIPAR · CONQUISTAR</small></div>
        </div>

        <section class="auth-register-card">
            <div class="auth-heading auth-heading--compact">
                <p class="auth-kicker">CADASTRO DE PARTICIPANTE</p>
                <h2>Crie sua conta.</h2>
                <p class="subtitle">Preencha seus dados para começar.</p>
            </div>

            <form asp-controller="Usuario" asp-action="Salvar" method="post" class="auth-register-form">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Tipo" value="Aluno" />

                <div class="form-row">
                    <div class="form-group col-md-5">
                        <label asp-for="Nome"></label>
                        <input asp-for="Nome" class="form-control" placeholder="Nome completo" autocomplete="name" required />
                        <span asp-validation-for="Nome" class="text-danger"></span>
                    </div>
                    <div class="form-group col-md-5">
                        <label asp-for="Email"></label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="voce@exemplo.com" autocomplete="email" required />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group col-md-5">
                        <label asp-for="Senha"></label>
                        <div class="password-wrapper">
                            <input asp-for="Senha" id="senhaCadastro" type="password" class="form-control" value="@ViewBag.Senha" autocomplete="new-password" required />
                            <button type="button" class="toggle-password" data-password-toggle="senhaCadastro" aria-label="Mostrar senha" aria-pressed="false">
                                <svg data-eye-open viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12s3.4-6 9.5-6 9.5 6 9.5 6-3.4 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.7"/></svg>
                                <svg data-eye-closed viewBox="0 0 24 24" aria-hidden="true" hidden><path d="m3 3 18 18M10.6 6.2A9.8 9.8 0 0 1 12 6c6.1 0 9.5 6 9.5 6a16 16 0 0 1-3 3.6M6.2 6.4C3.8 8 2.5 12 2.5 12s3.4 6 9.5 6a9.7 9.7 0 0 0 3.1-.5"/><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/></svg>
                            </button>
                        </div>
                        <span asp-validation-for="Senha" class="text-danger"></span>
                    </div>
                    <div class="form-group col-md-5">
                        <label for="confirmarSenha">Confirmar senha</label>
                        <div class="password-wrapper">
                            <input name="confirmarSenha" id="confirmarSenha" type="password" class="form-control" value="@ViewBag.ConfirmarSenha" autocomplete="new-password" required />
                            <button type="button" class="toggle-password" data-password-toggle="confirmarSenha" aria-label="Mostrar senha" aria-pressed="false">
                                <svg data-eye-open viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12s3.4-6 9.5-6 9.5 6 9.5 6-3.4 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.7"/></svg>
                                <svg data-eye-closed viewBox="0 0 24 24" aria-hidden="true" hidden><path d="m3 3 18 18M10.6 6.2A9.8 9.8 0 0 1 12 6c6.1 0 9.5 6 9.5 6a16 16 0 0 1-3 3.6M6.2 6.4C3.8 8 2.5 12 2.5 12s3.4 6 9.5 6a9.7 9.7 0 0 0 3.1-.5"/><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/></svg>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group col-md-5">
                        <label asp-for="Telefone"></label>
                        <input asp-for="Telefone" id="telefone" class="form-control mascara-telefone" placeholder="(99) 99999-9999" maxlength="15" inputmode="numeric" autocomplete="tel" />
                        <span asp-validation-for="Telefone" class="text-danger"></span>
                    </div>
                    <div class="form-group col-md-5">
                        <label asp-for="Ra">RA</label>
                        <input asp-for="Ra" id="ra" class="form-control mascara-ra" placeholder="1234/56-7" maxlength="9" required inputmode="numeric" />
                        <span asp-validation-for="Ra" class="text-danger"></span>
                    </div>
                </div>

                <button type="submit" class="btn-primary auth-submit">Criar minha conta <span aria-hidden="true">→</span></button>
            </form>
            <div class="auth-footer"><span>Já possui uma conta?</span> <a asp-controller="Usuario" asp-action="Login">Entrar <span aria-hidden="true">↗</span></a></div>
        </section>
        <p class="auth-register-footnote">EVENTOS <i></i> CONHECIMENTO <i></i> EXPERIÊNCIAS</p>
    </main>

    <script src="~/js/ui.js" asp-append-version="true"></script>
    <script>
        function somenteNumeros(valor) { return valor.replace(/\D/g, ""); }
        function formatarTelefone(valor) {
            let numeros = somenteNumeros(valor).slice(0, 11);
            if (numeros.length <= 2) return numeros;
            if (numeros.length <= 6) return `(${numeros.slice(0, 2)}) ${numeros.slice(2)}`;
            if (numeros.length <= 10) return `(${numeros.slice(0, 2)}) ${numeros.slice(2, 6)}-${numeros.slice(6)}`;
            return `(${numeros.slice(0, 2)}) ${numeros.slice(2, 7)}-${numeros.slice(7)}`;
        }
        function formatarRa(valor) {
            let numeros = somenteNumeros(valor).slice(0, 7);
            if (numeros.length <= 4) return numeros;
            if (numeros.length <= 6) return `${numeros.slice(0, 4)}/${numeros.slice(4)}`;
            return `${numeros.slice(0, 4)}/${numeros.slice(4, 6)}-${numeros.slice(6)}`;
        }
        document.addEventListener("DOMContentLoaded", function () {
            const campoTelefone = document.getElementById("telefone");
            const campoRa = document.getElementById("ra");
            if (campoTelefone) {
                campoTelefone.value = formatarTelefone(campoTelefone.value);
                campoTelefone.addEventListener("input", function () { this.value = formatarTelefone(this.value); });
            }
            if (campoRa) {
                campoRa.value = formatarRa(campoRa.value);
                campoRa.addEventListener("input", function () { this.value = formatarRa(this.value); });
            }
        });
    </script>
</body>
</html>
